---
import '../../styles/tokens.css';
---
<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ویرایش پروفایل — Parsi Games</title>
  <style>
    body { font-family: var(--font-fa); background: var(--color-bg); color: var(--color-text); display: flex; flex-direction: column; align-items: center; padding: 2rem; gap: 1rem; }
    .block { max-width: 32rem; width: 100%; }
    .en { direction: ltr; font-family: var(--font-en); margin-top: 2rem; }
    input, textarea { width: 100%; padding: 0.6rem; margin-bottom: 0.5rem; border-radius: 0.4rem; border: 1px solid #ccc; box-sizing: border-box; font-family: inherit; }
    button.btn { padding: 0.6rem 1.2rem; border-radius: 0.4rem; border: none; font-weight: 600; cursor: pointer; margin-inline-end: 0.5rem; }
    #save { background: var(--color-turquoise); color: white; }
    #delete { background: var(--color-crimson); color: white; }
    #status { min-height: 1.5rem; font-size: 0.9rem; }
  </style>
</head>
<body>
  <div class="block" lang="fa" dir="rtl">
    <h1>ویرایش پروفایل</h1>
    <p id="alias-display"></p>
    <textarea id="bio" placeholder="بیوگرافی کوتاه" rows="4"></textarea>
    <button class="btn" id="save">ذخیره</button>
    <button class="btn" id="delete">حذف حساب</button>
    <div id="status"></div>
  </div>
  <div class="block en" lang="en" dir="ltr">
    <h1>Edit Profile</h1>
    <p id="alias-display-en"></p>
    <textarea id="bio-en" placeholder="Short bio" rows="4"></textarea>
    <button class="btn" id="save-en">Save</button>
    <button class="btn" id="delete-en">Delete account</button>
    <div id="status-en"></div>
  </div>
  <script type="module">
    const API_BASE = 'https://api.parsigames.org';

    async function loadProfile() {
      const res = await fetch(`${API_BASE}/me`, { credentials: 'include' });
      if (!res.ok) {
        window.location.href = '/login';
        return;
      }
      const user = await res.json();
      document.getElementById('alias-display').textContent = `نام مستعار: ${user.alias}`;
      document.getElementById('alias-display-en').textContent = `Alias: ${user.alias}`;
      document.getElementById('bio').value = user.bio ?? '';
      document.getElementById('bio-en').value = user.bio ?? '';
    }

    async function saveProfile(bioId, statusId) {
      const bio = document.getElementById(bioId).value;
      const status = document.getElementById(statusId);
      const res = await fetch(`${API_BASE}/me`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ bio, skillTags: [], externalLinks: [] }),
      });
      status.textContent = res.ok ? 'ذخیره شد / Saved' : 'خطا / Error';
    }

    async function deleteAccount() {
      const confirmed = window.confirm('آیا مطمئن هستید؟ / Are you sure?');
      if (!confirmed) return;
      await fetch(`${API_BASE}/me/delete`, { method: 'POST', credentials: 'include' });
      window.location.href = '/';
    }

    document.getElementById('save').addEventListener('click', () => saveProfile('bio', 'status'));
    document.getElementById('save-en').addEventListener('click', () => saveProfile('bio-en', 'status-en'));
    document.getElementById('delete').addEventListener('click', deleteAccount);
    document.getElementById('delete-en').addEventListener('click', deleteAccount);

    loadProfile();
  </script>
</body>
</html>
