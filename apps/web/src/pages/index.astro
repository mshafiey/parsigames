<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Parsi Games</title>
</head>
<body>
  <script>
    const raw = (navigator.language || 'en').toLowerCase();
    const lang = raw.startsWith('fa') ? 'fa' : 'en';
    window.location.replace(`/${lang}/`);
  </script>
  <noscript>
    <p><a href="/fa/">فارسی</a> · <a href="/en/">English</a></p>
  </noscript>
</body>
</html>
