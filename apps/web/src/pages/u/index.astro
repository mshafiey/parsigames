---
import '../../styles/tokens.css';
---
<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>پروفایل — Parsi Games</title>
  <style>
    body { font-family: var(--font-fa); background: var(--color-bg); color: var(--color-text); display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 2rem; gap: 1rem; }
    .block { max-width: 28rem; width: 100%; text-align: center; }
    .en { direction: ltr; font-family: var(--font-en); margin-top: 2rem; }
  </style>
</head>
<body>
  <div class="block" lang="fa" dir="rtl" id="profile-fa">
    <h1 id="alias-fa"></h1>
    <p id="bio-fa">در حال بارگذاری...</p>
  </div>
  <div class="block en" lang="en" dir="ltr" id="profile-en">
    <h1 id="alias-en"></h1>
    <p id="bio-en">Loading...</p>
  </div>
  <script type="module">
    import { API_BASE } from '/src/lib/api.ts';

    const alias = window.location.pathname.replace(/^\/u\//, '').replace(/\/$/, '');
    document.getElementById('alias-fa').textContent = alias;
    document.getElementById('alias-en').textContent = alias;

    fetch(`${API_BASE}/users/${encodeURIComponent(alias)}`)
      .then(async (res) => {
        if (!res.ok) throw new Error('not found');
        return res.json();
      })
      .then((user) => {
        document.getElementById('bio-fa').textContent = user.bio || 'بدون بیوگرافی';
        document.getElementById('bio-en').textContent = user.bio || 'No bio yet';
      })
      .catch(() => {
        document.getElementById('bio-fa').textContent = 'کاربر پیدا نشد.';
        document.getElementById('bio-en').textContent = 'User not found.';
      });
  </script>
</body>
</html>
