---
import PageLayout from '../../layouts/PageLayout.astro';
---
<PageLayout
  lang="en"
  title="Parsi Games"
  pathFa="/fa/"
  pathEn="/en/"
  description="Building today, for a shared Iranian tomorrow."
>
  <style>
    body { margin: 0; background: var(--color-bg); color: var(--color-text); display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; text-align: center; padding: 2rem; gap: 2rem; }
    .block { max-width: 32rem; font-family: var(--font-en); }
    h1 { color: var(--color-lapis); font-size: 2rem; margin: 0 0 0.5rem; }
    p.tagline { color: var(--color-turquoise); font-weight: 600; margin: 0 0 1rem; }
    p.desc { margin: 0 0 1.5rem; line-height: 1.6; }
    a.cta { display: inline-block; background: var(--color-crimson); color: white; text-decoration: none; padding: 0.75rem 1.75rem; border-radius: 0.4rem; font-weight: 600; border-bottom: 3px solid var(--color-gold); }
  </style>
  <div class="block" lang="en" dir="ltr">
    <h1>Parsi Games</h1>
    <p class="tagline">Building today, for a shared Iranian tomorrow.</p>
    <p class="desc">An open-source platform connecting Iranian professionals in game development, programming, and digital art around the world.</p>
    <a class="cta" href="/en/login/">Join us</a>
  </div>
</PageLayout>
