---
import PageLayout from '../../../layouts/PageLayout.astro';
---
<PageLayout lang="en" title="Profile — Parsi Games" pathFa="/fa/u/" pathEn="/en/u/">
  <style>
    body { font-family: var(--font-en); background: var(--color-bg); color: var(--color-text); display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 2rem; gap: 1rem; }
    .block { max-width: 28rem; width: 100%; text-align: center; }
  </style>
  <div class="block" lang="en" dir="ltr">
    <h1 id="alias"></h1>
    <p id="bio">Loading...</p>
  </div>
  <script type="module">
    const API_BASE = 'https://api.parsigames.org';

    const alias = window.location.pathname.replace(/^\/en\/u\//, '').replace(/\/$/, '');
    document.getElementById('alias').textContent = alias;

    fetch(`${API_BASE}/users/${encodeURIComponent(alias)}`)
      .then(async (res) => {
        if (!res.ok) throw new Error('not found');
        return res.json();
      })
      .then((user) => {
        document.getElementById('bio').textContent = user.bio || 'No bio yet';
      })
      .catch(() => {
        document.getElementById('bio').textContent = 'User not found.';
      });
  </script>
</PageLayout>
